# ESPClaw for Seeed XIAO ESP32S3 Plus (大容量版)
# Hardware: 16MB Flash + 8MB Octal PSRAM
# Target: dual-core Xtensa LX7 @ 240MHz
# Ref: https://wiki.seeedstudio.com/xiao_esp32s3_getting_started/

# Flash configuration (Quad mode, 80MHz)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Performance optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM - Octal mode (8MB PSRAM uses Octal/DDR mode)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Memory allocation strategy
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Larger buffers with PSRAM
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n

# Free up internal DRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Task stacks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# Partition table: 16MB with OTA and LittleFS (from existing file)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Enable HTTP server for WebSocket gateway
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# Disable unused features to save flash
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_IPV6=n
CONFIG_BT_ENABLED=n
CONFIG_MBEDTLS_CERT_BUNDLE=y
CONFIG_MBEDTLS_CERT_BUNDLE_DEFAULT_FULL=y
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COREDUMP_ENABLE=n
CONFIG_ESP_GDBSTUB_ENABLED=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_ESPCLAW_CHANNEL_MQTT=y
CONFIG_ESPCLAW_CHANNEL_TELEGRAM=y
CONFIG_ESPCLAW_MQTT_BROKER_URL="mqtts://e855d1adcb91498097194e25175017dd.s1.eu.hivemq.cloud"

# Display: OLED SSD1306 128x64 (I2C) — Seeed XIAO ESP32S3 Plus
CONFIG_ESPCLAW_DISPLAY_OLED=y
# CONFIG_ESPCLAW_DISPLAY_TFT is not set

# OLED I2C pins (XIAO S3 Plus: D4=GPIO5 SDA, D5=GPIO6 SCL)
CONFIG_ESPCLAW_I2C_DEFAULT_SDA=5
CONFIG_ESPCLAW_I2C_DEFAULT_SCL=6

# Microphone I2S (expansion / shield default; override via NVS or web AP)
CONFIG_ESPCLAW_MIC_I2S_WS=42
CONFIG_ESPCLAW_MIC_I2S_SCK=41
CONFIG_ESPCLAW_MIC_I2S_SD=40

# Wake word (Phase 1 — RMS stub; build: ./build.sh xiao_s3_plus)
CONFIG_ESPCLAW_WAKEWORD_ENABLE=y
CONFIG_ESPCLAW_WAKEWORD_STUB_THRESHOLD=1200

# ESP-SR Configuration (Audio Front End & WakeNet)
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_MODEL_IN_FLASH=y
