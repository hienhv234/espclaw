# ESPClaw ESP32-S3 specific configuration
# Target: ESP32-S3 (N18R8) - 16MB Flash, 8MB Octal PSRAM

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Performance optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM - 8MB Octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Larger TLS buffers (S3 has plenty of RAM)
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=32768
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Event task stack
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# Partition table: 16MB with OTA
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
CONFIG_PARTITION_TABLE_CUSTOM=y

# Enable HTTP server
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# WiFi SoftAP support
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Disable verbose logs
CONFIG_MBEDTLS_DEBUG=n
