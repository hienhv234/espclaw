/*
 * ESPClaw - tool/builtin_tools.def
 * X-macro tool table. Add new tools here in 3 steps:
 *  1) Implement handler in tool_*.c with tool_execute_fn signature
 *  2) Declare handler in tool_registry.c (static forward decl)
 *  3) Add TOOL_ENTRY() line below
 */

/* GPIO */
TOOL_ENTRY("gpio_write",
    "Set GPIO pin HIGH/LOW. WARNING: Do NOT use this tool to control or turn OFF the WS2812 RGB NeoPixel LED; use rgb_led_set with r=0,g=0,b=0 instead.",
    "{\"type\":\"object\",\"properties\":{"
      "\"pin\":{\"type\":\"integer\"},"
      "\"state\":{\"type\":\"integer\",\"description\":\"0=LOW,1=HIGH\"}},"
    "\"required\":[\"pin\",\"state\"]}",
    tool_gpio_write)

TOOL_ENTRY("gpio_read",
    "Read GPIO pin state",
    "{\"type\":\"object\",\"properties\":{"
      "\"pin\":{\"type\":\"integer\"}},"
    "\"required\":[\"pin\"]}",
    tool_gpio_read)

TOOL_ENTRY("gpio_read_all",
    "Read all GPIO pin states",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_gpio_read_all)

TOOL_ENTRY("delay",
    "Wait N milliseconds (max 60000)",
    "{\"type\":\"object\",\"properties\":{"
      "\"milliseconds\":{\"type\":\"integer\"}},"
    "\"required\":[\"milliseconds\"]}",
    tool_delay)

/* Persistent memory */
TOOL_ENTRY("memory_set",
    "Store key-value in NVS. Key must start with u_",
    "{\"type\":\"object\",\"properties\":{"
      "\"key\":{\"type\":\"string\"},"
      "\"value\":{\"type\":\"string\"}},"
    "\"required\":[\"key\",\"value\"]}",
    tool_memory_set)

TOOL_ENTRY("memory_get",
    "Get value from NVS by key (u_*)",
    "{\"type\":\"object\",\"properties\":{"
      "\"key\":{\"type\":\"string\"}},"
    "\"required\":[\"key\"]}",
    tool_memory_get)

TOOL_ENTRY("memory_delete",
    "Delete key from NVS (u_*)",
    "{\"type\":\"object\",\"properties\":{"
      "\"key\":{\"type\":\"string\"}},"
    "\"required\":[\"key\"]}",
    tool_memory_delete)

TOOL_ENTRY("memory_list",
    "List all user memory keys",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_memory_list)

/* System diagnostics */
TOOL_ENTRY("get_diagnostics",
    "Get heap, uptime, chip info",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_system_diagnostics)

TOOL_ENTRY("get_version",
    "Get firmware version",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_get_version)

/* Cron - scheduled tasks */
TOOL_ENTRY("cron_schedule",
    "Schedule task: periodic/daily/once",
    "{\"type\":\"object\",\"properties\":{"
      "\"type\":{\"type\":\"string\",\"enum\":[\"periodic\",\"daily\",\"once\"]},"
      "\"action\":{\"type\":\"string\"},"
      "\"interval_seconds\":{\"type\":\"integer\"},"
      "\"hour\":{\"type\":\"integer\"},"
      "\"minute\":{\"type\":\"integer\"},"
      "\"delay_seconds\":{\"type\":\"integer\"}},"
    "\"required\":[\"type\",\"action\"]}",
    tool_cron_schedule)

TOOL_ENTRY("cron_list",
    "List scheduled tasks",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_cron_list)

TOOL_ENTRY("cron_cancel",
    "Cancel task by ID",
    "{\"type\":\"object\",\"properties\":{"
      "\"id\":{\"type\":\"integer\"}},"
    "\"required\":[\"id\"]}",
    tool_cron_cancel)

TOOL_ENTRY("cron_cancel_all",
    "Cancel all scheduled tasks",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_cron_cancel_all)

/* Time */
TOOL_ENTRY("get_time",
    "Get current time and timezone",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_get_time)

TOOL_ENTRY("set_timezone",
    "Set timezone (e.g. CST-8, UTC)",
    "{\"type\":\"object\",\"properties\":{"
      "\"timezone\":{\"type\":\"string\"}},"
    "\"required\":[\"timezone\"]}",
    tool_set_timezone)

/* Persona */
TOOL_ENTRY("set_persona",
    "Set AI style: neutral/friendly/technical/witty",
    "{\"type\":\"object\",\"properties\":{"
      "\"persona\":{\"type\":\"string\"}},"
    "\"required\":[\"persona\"]}",
    set_persona_exec)

TOOL_ENTRY("get_persona",
    "Get current AI persona",
    "{\"type\":\"object\",\"properties\":{}}",
    get_persona_exec)

/* Network */
TOOL_ENTRY("wifi_scan",
    "Scan WiFi networks (disconnects briefly!)",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_wifi_scan)

TOOL_ENTRY("get_network_info",
    "Get IP, gateway, DNS, RSSI, MAC, SSID",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_get_network_info)

/* Wake word (ESP32-S3 + PSRAM when enabled) */
TOOL_ENTRY("wakeword_enable",
    "Enable/disable wake word listener",
    "{\"type\":\"object\",\"properties\":{"
      "\"enabled\":{\"type\":\"integer\",\"description\":\"0=OFF,1=ON\"}}}",
    tool_wakeword_enable)

TOOL_ENTRY("wakeword_status",
    "Wake word listener status",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_wakeword_status)

TOOL_ENTRY("wakeword_set_threshold",
    "Set RMS stub detection threshold",
    "{\"type\":\"object\",\"properties\":{"
      "\"threshold\":{\"type\":\"integer\"}},"
    "\"required\":[\"threshold\"]}",
    tool_wakeword_set_threshold)

TOOL_ENTRY("wakeword_train_start",
    "Start custom wake word training session",
    "{\"type\":\"object\",\"properties\":{"
      "\"label\":{\"type\":\"string\"}}}",
    tool_wakeword_train_start)

TOOL_ENTRY("wakeword_train_record",
    "Record one training sample (type pos or neg)",
    "{\"type\":\"object\",\"properties\":{"
      "\"type\":{\"type\":\"string\",\"enum\":[\"pos\",\"neg\"]}}}",
    tool_wakeword_train_record)

TOOL_ENTRY("wakeword_train_finish",
    "Finish training and request model build",
    "{\"type\":\"object\",\"properties\":{}}",
    tool_wakeword_train_finish)

TOOL_ENTRY("rgb_led_set",
    "Set WS2812 RGB LED/NeoPixel colors. Default pin is 48. To turn OFF the LED, call this tool with r=0, g=0, b=0.",
    "{\"type\":\"object\",\"properties\":{"
      "\"pin\":{\"type\":\"integer\",\"description\":\"GPIO pin number (optional, defaults to 48)\"},"
      "\"r\":{\"type\":\"integer\",\"description\":\"Red color channel 0-255\"},"
      "\"g\":{\"type\":\"integer\",\"description\":\"Green color channel 0-255\"},"
      "\"b\":{\"type\":\"integer\",\"description\":\"Blue color channel 0-255\"},"
      "\"index\":{\"type\":\"integer\",\"description\":\"Index of LED in strip (default 0)\"},"
      "\"count\":{\"type\":\"integer\",\"description\":\"Total number of LEDs in strip (default 1)\"}},"
    "\"required\":[\"r\",\"g\",\"b\"]}",
    tool_rgb_led_set)

TOOL_ENTRY("rgb_led_effect",
    "Run asynchronous WS2812 RGB LED effects. Default pin is 48.",
    "{\"type\":\"object\",\"properties\":{"
      "\"pin\":{\"type\":\"integer\",\"description\":\"GPIO pin number (optional, defaults to 48)\"},"
      "\"effect\":{\"type\":\"string\",\"enum\":[\"blink\",\"cycle\",\"rainbow\"],\"description\":\"Type of effect to run\"},"
      "\"r\":{\"type\":\"integer\",\"description\":\"Red color channel for blink (0-255)\"},"
      "\"g\":{\"type\":\"integer\",\"description\":\"Green color channel for blink (0-255)\"},"
      "\"b\":{\"type\":\"integer\",\"description\":\"Blue color channel for blink (0-255)\"},"
      "\"delay_ms\":{\"type\":\"integer\",\"description\":\"Delay interval in milliseconds (default 500)\"},"
      "\"count\":{\"type\":\"integer\",\"description\":\"Number of repetitions (for blink/cycle) or total duration in seconds (for rainbow) (default 10)\"}},"
    "\"required\":[\"effect\"]}",
    tool_rgb_led_effect)
