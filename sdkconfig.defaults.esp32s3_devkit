# ESPClaw for ESP32-S3 DevKit 1 (N16R8)
# Hardware: 16MB Flash + 8MB PSRAM
# Target: dual-core Xtensa LX7 @ 240MHz
# 
# Pinout Reference:
# - GPIO0-21: Digital I/O
# - GPIO0: Boot button
# - GPIO38-48: Analog inputs
# - USB-JTAG: GPIO19 (D-) / GPIO20 (D+)
# - SPI Flash: GPIO27-32

# Flash configuration (16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Performance optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM - Octal mode (8MB)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Memory buffers
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Free up internal DRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n

# Task stacks (optimized to save DRAM)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Partition table: 16MB with OTA and LittleFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# Enable HTTPS server
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# Enable WiFi SoftAP support
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_IPV6=n
CONFIG_BT_ENABLED=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COREDUMP_ENABLE=n
CONFIG_ESP_GDBSTUB_ENABLED=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_MBEDTLS_DEBUG=n
CONFIG_MBEDTLS_CERT_BUNDLE=y
CONFIG_MBEDTLS_CERT_BUNDLE_DEFAULT_FULL=y

# ESPClaw specific
CONFIG_ESPCLAW_WIFI_SSID=""
CONFIG_ESPCLAW_WIFI_PASSWORD=""
CONFIG_ESPCLAW_LLM_API_KEY=""
CONFIG_ESPCLAW_CHANNEL_MQTT=y
CONFIG_ESPCLAW_CHANNEL_TELEGRAM=y
CONFIG_ESPCLAW_MQTT_BROKER_URL="mqtts://e855d1adcb91498097194e25175017dd.s1.eu.hivemq.cloud"
